#!/bin/sh
# keel-web: on remove and on purge, take the package's sites out of
# sites-enabled/ and give Debian's default site its link back. The pages
# leave with a remove (they are not conffiles), so the default site cannot
# stay enabled; the Anubis front serves the same pages. The two conffiles
# stay in sites-available/ until the purge, as dpkg has it. Debian's link
# comes back when the postinst had removed it (the record
# /var/lib/keel-web/debian-default-unlinked) and nothing took its place
# meanwhile; the postinst's markers go, so a reinstall enables the default
# site again, and the purge takes the state directory. Links that are not
# keel-web's, and a /var/www/keel-default that is not its link, are left
# alone. A running Nginx is reloaded by the nginx-reload trigger, and
# systemd forgets Nginx's drop-in, which left with the package. Paths are
# under DPKG_ROOT, as dpkg sets it (empty on a machine); tests/package.bats
# runs this script against a scratch root that way.
set -e

R="${DPKG_ROOT:-}"
SITE=/etc/nginx/sites-available/keel-default
FRONT_SITE=/etc/nginx/sites-available/default-anubis
DEBIAN_SITE=/etc/nginx/sites-available/default
PAGES=/usr/share/keel-web/default-site
LINK="$R/etc/nginx/sites-enabled/keel-default"
FRONT="$R/etc/nginx/sites-enabled/default-anubis"
DEBIAN="$R/etc/nginx/sites-enabled/default"
WWW="$R/var/www/keel-default"
STATE="$R/var/lib/keel-web"
RECORD="$STATE/debian-default-unlinked"
ENABLED="$STATE/keel-default-enabled"

case "$1" in
    remove|purge)
        if [ "$(readlink "$FRONT" || true)" = "$FRONT_SITE" ]; then
            rm -f "$FRONT"
        fi
        if [ "$(readlink "$LINK" || true)" = "$SITE" ]; then
            rm -f "$LINK"
        fi
        if [ -f "$RECORD" ] && [ ! -e "$DEBIAN" ] && [ ! -L "$DEBIAN" ] \
                && [ -f "$R$DEBIAN_SITE" ]; then
            ln -s "$DEBIAN_SITE" "$DEBIAN"
        fi
        rm -f "$RECORD" "$ENABLED"
        if [ "$(readlink "$WWW" || true)" = "$PAGES" ]; then
            rm -f "$WWW"
        fi
        if [ "$1" = purge ]; then
            rm -rf "$STATE"
        else
            rmdir "$STATE" 2>/dev/null || true
        fi
        if [ -z "$R" ] && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
