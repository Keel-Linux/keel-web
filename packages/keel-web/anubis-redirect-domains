#!/bin/bash
# /usr/lib/keel-web/anubis-redirect-domains FILE
#
# Writes REDIRECT_DOMAINS=<names and addresses> to FILE, the environment
# file anubis@keel.service reads (its drop-in keel-web.conf runs this
# before each start). Without REDIRECT_DOMAINS, Anubis redirects a solved
# challenge to any host: its pass-challenge compares the host of redir
# with itself (lib/anubis.go, PassChallenge), an open redirect. Keel Web's
# default site answers by name and by IP, so the list is the machine's
# short name and fqdn and every global address, IPv6 bracketed as the host
# of a URL is. Lower case, each once, in that order.
#
# Read at each start: a name or an address that changes later needs
# `systemctl restart anubis@keel`. When keel renders the sites of handbook
# decision 0042, the list becomes their `names`.
#
# Exit codes: 0 written, 1 nothing to write (no name, no address: an
# empty list would allow every host, so the unit must not start), 2 usage.
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "usage: anubis-redirect-domains FILE" >&2
    exit 2
fi
out="$1"

hosts=()
add() {
    local host="${1,,}" known
    [ -n "$host" ] || return 0
    for known in "${hosts[@]}"; do
        [ "$known" = "$host" ] && return 0
    done
    hosts+=("$host")
}

add "$(hostname 2>/dev/null || true)"
add "$(hostname -f 2>/dev/null || true)"
while read -r _ _ family address _; do
    case "$family" in
        inet) add "${address%/*}" ;;
        inet6) add "[${address%/*}]" ;;
    esac
done < <(ip -o addr show scope global)

if [ "${#hosts[@]}" -eq 0 ]; then
    echo "anubis-redirect-domains: no name and no address to allow; Anubis would redirect anywhere, so it is not started" >&2
    exit 1
fi

mkdir -p "$(dirname "$out")"
tmp="$(mktemp "$out.XXXXXX")"
(IFS=,; echo "REDIRECT_DOMAINS=${hosts[*]}") > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$out"
