# keel-web: the default site with Anubis in front of it (handbook
# decisions 0030 and 0041, step 7). Linked from sites-enabled/ in place of
# keel-web's `keel-default` while the anubis overlay is enabled, by
# /usr/lib/keel/overlays/anubis/state.d/50keel-web, which keel spec apply
# runs; never by hand, and never at installation.
#
# The pipeline of 0030: Nginx takes the request (Coraza, when its overlay
# is enabled, inspects it here, in the http block), Anubis decides, and
# what it allows comes back to Nginx on a unix socket, where the content
# is served. Anubis keys on the client's address, which the snippet passes
# in X-Real-IP; the socket trusts that header from unix: only, so nothing
# outside the machine can set it (0042, "Real client IP").
#
# HTTPS only, port 80 redirecting (0042, redirect_http): Anubis sets its
# cookies Secure, so over plain HTTP a browser never sends them back and
# never passes the challenge. The certificate is the machine's, the
# `default` of 0042: self-signed by keel-host-keys at the first boot until
# the confconsole Certificate screen issues one through ACME, at the same
# paths. So no HSTS here: over a self-signed certificate it locks visitors
# out (0042, tls.hsts). By name or by IP alike: the default server serves
# both, as the usage screen shows the IP. Anubis redirects a solved
# challenge only to the origin the request came to (anubis
# 1.27.0-0+keel3, REDIRECT_DOMAINS left empty), so any name the site is
# reached by works and no other host can be reached through it.
#
# Until keel renders sites of its own (0042), this is the one site Keel
# Web serves in the cloud modes: the pages of keel-default, the default
# site of a simple installation, from /var/www/keel-default, with its 404
# and 50x pages (on 443 too, for the errors Nginx answers itself) and no
# server version. The two sites are never enabled together.

server {
	listen [::]:80 default_server;
	listen 80 default_server;
	server_name _;
	server_tokens off;

	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen [::]:443 ssl default_server;
	listen 443 ssl default_server;
	http2 on;
	server_name _;
	server_tokens off;

	ssl_certificate /usr/local/share/ca-certificates/cert.crt;
	ssl_certificate_key /etc/ssl/private/cert.key;
	# As common's conf/turnkey.d/zz-ssl-ciphers sets them for every web
	# server of an appliance (Mozilla's "intermediate"): TLS 1.2 and 1.3,
	# and for 1.2 forward secret ciphers only.
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305';
	ssl_prefer_server_ciphers off;

	# Nginx answers here itself when Anubis is down or slow (502, 504):
	# the default site's pages, not nginx's stock page.
	root /var/www/keel-default;
	error_page 404 /404.html;
	error_page 500 502 503 504 /50x.html;

	# TODO(Keel-Linux/tracker#51, decision 0042 tls.hsts): add
	# Strict-Transport-Security once the confconsole Certificate screen has
	# issued a CA's certificate through ACME; never over the self-signed one.
	#
	# A tls-passthrough site of 0042 needs the stream front on port 443:
	# then these two listen lines must go, and this server listens behind
	# it on unix:/run/nginx/keel-https.sock (Keel-Linux/tracker#51).

	location = /404.html {
		internal;
	}

	location = /50x.html {
		internal;
	}

	location / {
		include /etc/nginx/snippets/keel-anubis.conf;
	}
}

server {
	listen unix:/run/nginx/keel-app.sock;
	server_name _;
	server_tokens off;
	set_real_ip_from unix:;
	real_ip_header X-Real-IP;

	root /var/www/keel-default;
	index index.html;

	error_page 404 /404.html;
	error_page 500 502 503 504 /50x.html;

	location = /404.html {
		internal;
	}

	location = /50x.html {
		internal;
	}

	location / {
		try_files $uri $uri/ =404;
	}
}
