# keel-web: Anubis's cookies over plain HTTP (handbook decision 0079).
# Linked as /etc/anubis/keel-web-http.env by /usr/lib/keel-web/http-mode
# while the machine's certificate is self-signed, when port 80 serves the
# site through Anubis; removed when a certificate authority's certificate
# is in place and port 80 redirects to HTTPS. anubis@keel.service reads it
# after /etc/anubis/keel.env (keel-web's drop-in), so these two values win.
#
# A browser refuses a Secure cookie that a plain HTTP page sets. With
# Anubis's default, a browser on port 80 never keeps the pass of a
# challenge and gets the challenge again and again. The pass is not a
# credential: it only says that this browser solved a challenge. SameSite
# None needs Secure, so it is Lax here. Partitioned (CHIPS) needs Secure
# too: Chrome refuses a Partitioned cookie without it, and Anubis sets
# Partitioned by default, so the browser of the commissioning run was told
# "Your browser is configured to disable cookies" (BR1 and BR2,
# 2026-11-06).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_PARTITIONED=false
