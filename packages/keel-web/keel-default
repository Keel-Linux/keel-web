# keel-web: the default site of Keel Web (handbook decisions 0030 and 0042,
# the first site of Keel-Linux/tracker#51). Linked from sites-enabled/ by
# the package's postinst in place of Debian's default site, whose link it
# removes and whose file it leaves in sites-available/ (the postrm puts the
# link back); taken out by /usr/lib/keel/overlays/anubis/state.d/50keel-web
# while the anubis overlay is enabled, when default-anubis stands here, and
# put back when it is disabled. Never edited by hand: it is a conffile, and
# an operator's own default server goes in a file of theirs.
#
# What a simple installation serves: the default server on ports 80 and
# 443, IPv6 first and IPv4 on, the same placeholder on both schemes. HTTP
# is served, not redirected: ACME's http-01 needs port 80 to answer, and
# the redirect to HTTPS is the cloud site's (default-anubis, behind which
# Anubis's Secure cookies need it). web.listen.ipv4 of 0042 is keel's to
# honour when it renders the sites; this file is static and listens on
# both families.
#
# /keel-health answers 204 here, as keel-overlay-nginx's
# conf.d/keel-health.conf does on the loopback addresses of port 80, which
# it takes (Nginx hands a request to the exact address first): the
# manifest's check reaches that server, and anything else, the loopback on
# 443 included, reaches this one, on both schemes.
#
# TLS is the machine's certificate as turnkey-make-ssl-cert --default
# writes it, the `default` certificate of 0042: self-signed by
# keel-host-keys.service at the first boot, before Nginx starts, and
# replaced in place by the confconsole Certificate screen through ACME.
# cert.pem is the certificate, the key and the DH parameters in one file,
# the file Webmin and the machine's other services read; Nginx reads the
# certificate chain from it and the other two blocks from their own files.
# Protocols and ciphers are common's conf/turnkey.d/zz-ssl-ciphers
# (Mozilla's "intermediate"): TLS 1.2 and 1.3, forward secret ciphers
# only; no session tickets, whose key Nginx never rotates. No HSTS: over a
# self-signed certificate it locks visitors out. Nginx starts after
# keel-host-keys.service (the package's nginx.service.d/keel-web.conf),
# since without the pair it starts on neither port.
#
# The pages are /var/www/keel-default, a link the postinst makes to
# /usr/share/keel-web/default-site (Debian policy keeps a package's files
# out of /var/www). An operator who wants something else served while no
# site is configured replaces the link with a directory of theirs; the
# postinst leaves one that is there alone.

server {
	listen [::]:80 default_server;
	listen 0.0.0.0:80 default_server;
	listen [::]:443 ssl default_server;
	listen 0.0.0.0:443 ssl default_server;
	http2 on;
	server_name _;
	server_tokens off;

	ssl_certificate /etc/ssl/private/cert.pem;
	ssl_certificate_key /etc/ssl/private/cert.key;
	ssl_dhparam /etc/ssl/private/dhparams.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305';
	ssl_prefer_server_ciphers off;
	ssl_session_tickets off;

	# TODO(Keel-Linux/tracker#51, decision 0042 tls.hsts): add
	# Strict-Transport-Security once the confconsole Certificate screen has
	# issued a CA's certificate through ACME; never over the self-signed one.

	root /var/www/keel-default;
	index index.html;

	error_page 404 /404.html;
	error_page 500 502 503 504 /50x.html;

	location = /keel-health {
		# try_files, not return, as keel-health.conf has it: return
		# answers in the rewrite phase, before Coraza sees the request.
		# No file has this name, so the answer is always the 204.
		try_files /.keel-health-is-no-file =204;
	}

	location = /404.html {
		internal;
	}

	location = /50x.html {
		internal;
	}

	location / {
		try_files $uri $uri/ =404;
	}
}
